# Copy to .env and fill in real values. .env is git-ignored; this file is committed.
# Mirrors the keys currently in .env — see docs/01-SETUP-GUIDE.md §2 for where each comes from.

# ─── Persona inference (Groq) ───────────────────────────────────────────────
GROQ_API_KEY=

# ─── Auth — GitHub OAuth app ────────────────────────────────────────────────
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ─── Auth — Google OAuth app ────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Data — production (Neon Postgres, Upstash Redis) ──────────────────────
DATABASE_URL_PROD=postgresql+asyncpg://user:password@host/dbname?sslmode=require
REDIS_URL_PROD=rediss://default:password@host:6379

# ─── Object storage — audio artefacts (Supabase Storage / S3-compatible) ───
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=interactai-audio
S3_REGION=ap-southeast-1
S3_ENDPOINT=                     # e.g. https://<project-ref>.storage.supabase.co/storage/v1/s3

# ─── Hugging Face — model downloads ─────────────────────────────────────────
HF_TOKEN=

# ─── Weights & Biases — training run tracking (Phase 5) ────────────────────
WANDB_API_KEY=

# ─── Sentry — error tracking (optional) ─────────────────────────────────────
SENTRY_DSN_API=
SENTRY_DSN_WEB=

# ─── Langfuse — LLM tracing (optional) ──────────────────────────────────────
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
