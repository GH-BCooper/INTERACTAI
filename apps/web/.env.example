# Copy to .env.local (git-ignored) for local development. Next.js only loads .env* files from
# this directory (apps/web), not the repo root — these are genuinely separate from the root
# .env.example, which services/api and services/realtime read instead.
#
# Both have working defaults baked into apps/web/lib/api/client.ts and
# apps/web/lib/report/persona-audio-cache.ts matching `make api`/`make realtime`'s default
# ports, so this file is only needed if you've changed those.

# services/api — REST + auth. Must match settings.api_base_url on that side (root .env).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# services/realtime — the practice room's WS URL is minted by the API and used as-is; this is
# only for the report replay's on-demand persona-audio endpoint (POST /synthesize, Task 3.4d),
# which the browser calls directly.
NEXT_PUBLIC_REALTIME_HTTP_URL=http://localhost:8080
